#!/bin/sh

REPO_URL="https://github.com/nightflyza/PureNAS.git"
TARGET_DIR="/etc/PureNAS"
BRANCH="main"

echo "Usage example:"
echo "  $0          Update to current main branch"
echo "  $0 001      Update to specific release tag (e.g. 001, 002..)"
echo ""

RELEASE_TAG="${1:-}"

if [ ! -d "$TARGET_DIR/.git" ]; then
    rm -rf "$TARGET_DIR"
    git clone "$REPO_URL" "$TARGET_DIR"
fi

cd "$TARGET_DIR" || exit 1

if [ -f "purenas.conf" ]; then
    CONFIG_BACKUP="/tmp/purenas.conf.backup"
    cp "purenas.conf" "$CONFIG_BACKUP"
fi

git fetch origin
git fetch origin --tags

if [ -n "$RELEASE_TAG" ]; then
    if git rev-parse "refs/tags/$RELEASE_TAG" >/dev/null 2>&1 || git rev-parse "$RELEASE_TAG" >/dev/null 2>&1; then
        git checkout --force "$RELEASE_TAG"
        UPDATED_TO="$RELEASE_TAG"
    else
        echo "Error: release tag '$RELEASE_TAG' not found. Available tags:"
        git tag -l
        exit 1
    fi
else
    git reset --hard "origin/$BRANCH"
    UPDATED_TO="main ($(git rev-parse --short HEAD))"
fi

git clean -fdx

if [ -f "$CONFIG_BACKUP" ]; then
    cp "$CONFIG_BACKUP" "purenas.conf"
    rm "$CONFIG_BACKUP"
fi

echo "Updated to: $UPDATED_TO"