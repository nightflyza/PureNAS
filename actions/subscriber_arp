#!/usr/bin/env bash
set -e

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
source "${SCRIPT_DIR}/../purenas.conf"

IP="$1"
MAC="$2"
arpcmd="/usr/sbin/arp"

if [ -z "$IP" ] || [ -z "$MAC" ]; then
    echo "Usage: $0 <IP_ADDRESS> <MAC_ADDRESS>"
    exit 1
fi

if [ "${DISABLE_ARPFIX:-NO}" = "YES" ]; then
    echo "== DISABLE_ARPFIX is set, skipping static ARP for ${IP} =="
else
    ${arpcmd} -s ${IP} ${MAC}
    echo "== Added static ARP entry for ${IP} with MAC ${MAC} =="
fi
