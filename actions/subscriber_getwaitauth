#!/usr/bin/env bash
set -e

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
source "${SCRIPT_DIR}/../purenas.conf"

declare -A ARP
while read -r line; do
    ip="${line%% *}"
    mac="${line#*lladdr }"
    mac="${mac%% *}"
    if [ -n "$ip" ] && [ -n "$mac" ] && [ "$mac" != "$line" ] && [[ "$mac" == *:* ]]; then
        ARP["$ip"]="$mac"
    fi
done < <(ip -4 neigh show 2>/dev/null || true)

WAITAUTH_IPS=()
raw=$(nft list set ${NFT_FAMILY} ${NFT_TABLE} waitauth_clients 2>/dev/null || true)
if [ -n "$raw" ]; then
    while read -r ip; do
        WAITAUTH_IPS+=( "$ip" )
    done < <(echo "$raw" | grep -oE '\b[0-9]+\.[0-9]+\.[0-9]+\.[0-9]+\b' || true)
fi

sorted=($(printf '%s\n' "${WAITAUTH_IPS[@]}" | sort -u -V))

for ip in "${sorted[@]}"; do
    mac="${ARP[$ip]:-}"
    printf '%s-%s\n' "$ip" "$mac"
done
