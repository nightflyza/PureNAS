#!/usr/bin/env bash
set -e

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
source "${SCRIPT_DIR}/../purenas.conf"

if [ "${UNAUTH_DETECTION_ENABLED:-NO}" != "YES" ]; then
    exit 0
fi

declare -A ARP
while read -r line; do
    ip="${line%% *}"
    mac="${line#*lladdr }"
    mac="${mac%% *}"
    if [ -n "$ip" ] && [ -n "$mac" ] && [ "$mac" != "$line" ] && [[ "$mac" == *:* ]]; then
        ARP["$ip"]="$mac"
    fi
done < <(ip -4 neigh show 2>/dev/null || true)

WAITAUTH_IPS=()
raw=$(nft list set ${NFT_FAMILY} ${NFT_TABLE} waitauth_clients 2>/dev/null || true)
if [ -n "$raw" ]; then
    while read -r word; do
        if [[ "$word" =~ ^[0-9]+\.[0-9]+\.[0-9]+\.[0-9]+$ ]]; then
            WAITAUTH_IPS+=( "$word" )
        fi
    done < <(echo "$raw" | tr ',{}' ' \n ')
fi

sorted=($(printf '%s\n' "${WAITAUTH_IPS[@]}" | sort -u -V))

for ip in "${sorted[@]}"; do
    mac="${ARP[$ip]:-}"
    printf '%s-%s\n' "$ip" "$mac"
done
