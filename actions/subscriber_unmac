#!/usr/bin/env bash
set -e

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
source "${SCRIPT_DIR}/../purenas.conf"

IP="$1"

arpcmd="/usr/sbin/arp"

if [ -z "$IP" ]; then
    echo "Usage: $0 <IP_ADDRESS>"
    exit 1
fi

if [ "${FW_MACFIX:-NO}" = "YES" ]; then
    elem="$(nft list set ${NFT_FAMILY} ${NFT_TABLE} fixed_clients 2>/dev/null | grep -oE '([0-9]{1,3}\.){3}[0-9]{1,3} \. [0-9a-f:]+' | while read -r e; do if [[ "$e" =~ ^${IP}\ \.\  ]]; then echo "$e"; break; fi; done)"
    if [ -n "$elem" ]; then
        ip_part="${elem%% . *}"
        mac_part="${elem#* . }"
        ip_part="${ip_part% }"
        mac_part="${mac_part# }"
        nft delete element ${NFT_FAMILY} ${NFT_TABLE} fixed_clients { "${ip_part}" . "${mac_part}" } 2>/dev/null || true
        nft delete element ${NFT_FAMILY} ${NFT_TABLE} fixed_ips { "${ip_part}" } 2>/dev/null || true
        echo "== Removed IP+MAC static entry: ${ip_part} . ${mac_part} =="
    fi
fi

if [ "${DISABLE_ARPFIX:-NO}" != "YES" ]; then
    ${arpcmd} -d ${IP}
    echo "== Removed static ARP entry for ${IP} =="
fi
