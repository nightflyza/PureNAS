RewriteEngine On
RewriteBase /api/

RewriteRule ^subscriber/getall$ index.php?subscriber=getall [L,QSA]
RewriteRule ^subscriber/getwaitauth$ index.php?subscriber=getwaitauth [L,QSA]
RewriteRule ^subscriber/allow/([0-9\.]+)$ index.php?subscriber=allow&ip=$1 [L,QSA]
RewriteRule ^subscriber/disallow/([0-9\.]+)$ index.php?subscriber=disallow&ip=$1 [L,QSA]
RewriteRule ^subscriber/shape/([0-9\.]+)/([0-9]+)$ index.php?subscriber=shape&ip=$1&download=$2 [L,QSA]
RewriteRule ^subscriber/shape/([0-9\.]+)/([0-9]+)/([0-9]+)$ index.php?subscriber=shape&ip=$1&download=$2&upload=$3 [L,QSA]
RewriteRule ^subscriber/unshape/([0-9\.]+)$ index.php?subscriber=unshape&ip=$1 [L,QSA]
RewriteRule ^subscriber/mac/([0-9\.]+)/([0-9a-fA-F:]+)$ index.php?subscriber=mac&ip=$1&mac=$2 [L,QSA]
RewriteRule ^subscriber/unmac/([0-9\.]+)$ index.php?subscriber=unmac&ip=$1 [L,QSA]
RewriteRule ^ban/ip/([0-9\.]+(\/[0-9]+)?)$ index.php?action=ban&type=ip&addr=$1 [L,QSA]
RewriteRule ^unban/ip/([0-9\.]+(\/[0-9]+)?)$ index.php?action=unban&type=ip&addr=$1 [L,QSA]
RewriteRule ^ban/icmp/([0-9\.]+(\/[0-9]+)?)$ index.php?action=ban&type=icmp&addr=$1 [L,QSA]
RewriteRule ^unban/icmp/([0-9\.]+(\/[0-9]+)?)$ index.php?action=unban&type=icmp&addr=$1 [L,QSA]
RewriteRule ^system/info$ index.php?system=info [L,QSA]

RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^.*$ index.php [L,QSA]
