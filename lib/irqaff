#!/usr/bin/env bash
set -e

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
source "${SCRIPT_DIR}/../purenas.conf"

if [ "${IRQ_AFFINITY_ENABLED}" = "YES" ]; then
    echo "== Applying IRQ affinity =="

    if systemctl is-active --quiet irqbalance 2>/dev/null; then
        echo "== Stopping irqbalance service =="
        systemctl stop irqbalance 2>/dev/null || true
    fi

    if systemctl is-enabled --quiet irqbalance 2>/dev/null; then
        echo "== Disabling irqbalance service =="
        systemctl disable irqbalance 2>/dev/null || true
    fi

    if pgrep -x irqbalance >/dev/null 2>&1; then
        echo "== Killing irqbalance process =="
        killall irqbalance >/dev/null 2>&1 || true
        while pgrep -x irqbalance >/dev/null 2>&1; do
            echo "== Waiting for irqbalance to shutdown =="
            sleep 1
        done
    fi

    cpulist_to_mask() {
        local list="$1"
        local mask=0

        IFS=',' read -ra PARTS <<< "$list"
        for p in "${PARTS[@]}"; do
            if [[ "$p" =~ "-" ]]; then
                start=${p%-*}
                end=${p#*-}
                for ((i=start;i<=end;i++)); do
                    mask=$((mask | (1 << i)))
                done
            else
                mask=$((mask | (1 << p)))
            fi
        done

        printf "%x\n" "$mask"
    }

    apply_irq_affinity() {
        local iface="$1"
        local pci_dev=""

        if [ ! -d "/sys/class/net/$iface" ]; then
            echo "[!] Interface $iface not found, skipping"
        else
            echo "[*] Processing interface: $iface"

            local device_path
            device_path=$(readlink -f /sys/class/net/$iface/device 2>/dev/null || echo "")
            if [ -z "$device_path" ]; then
                echo "[!] Could not detect device path for $iface, skipping"
            else
                pci_dev=$(echo "$device_path" | grep -oE '[0-9a-f]{4}:[0-9a-f]{2}:[0-9a-f]{2}\.[0-9a-f]' | head -1)
                if [ -z "$pci_dev" ]; then
                    echo "[!] Could not extract PCI device ID for $iface, skipping"
                else
                    echo "[*] PCI device: $pci_dev"

                    local numa_node
                    numa_node=$(cat /sys/bus/pci/devices/$pci_dev/numa_node 2>/dev/null || echo "-1")

                    if [ "$numa_node" -lt 0 ]; then
                        echo "[!] NUMA node not detected for $iface, skipping"
                    else
                        echo "[*] NUMA node: $numa_node"

                        local cpu_list
                        cpu_list=$(cat /sys/devices/system/node/node$numa_node/cpulist 2>/dev/null || echo "")
                        if [ -z "$cpu_list" ]; then
                            echo "[!] Could not get CPU list for NUMA node $numa_node, skipping"
                        else
                            echo "[*] CPU list: $cpu_list"

                            local cpu_mask
                            cpu_mask=$(cpulist_to_mask "$cpu_list")
                            echo "[*] CPU mask: $cpu_mask"

                            local irqs
                            irqs=$(grep "$iface" /proc/interrupts 2>/dev/null | awk '{print $1}' | tr -d ':' || echo "")

                            if [ -z "$irqs" ]; then
                                echo "[!] IRQs not found for $iface, skipping"
                            else
                                for irq in $irqs; do
                                    echo "$cpu_mask" > /proc/irq/$irq/smp_affinity 2>/dev/null || {
                                        echo "[!] Failed to set affinity for IRQ $irq"
                                        continue
                                    }
                                    echo "[+] IRQ $irq => NUMA $numa_node"
                                done

                                echo "== All IRQs for $iface assigned to CPUs (NUMA node $numa_node) =="
                            fi
                        fi
                    fi
                fi
            fi
        fi
    }

    for interface in "$LAN_IF" "$WAN_IF"; do
        if [ -n "$interface" ]; then
            apply_irq_affinity "$interface"
        fi
    done


fi