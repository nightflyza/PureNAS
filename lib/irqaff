#!/usr/bin/env bash
set -e

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
source "${SCRIPT_DIR}/../purenas.conf"

if [ "${IRQ_AFFINITY_ENABLED}" = "YES" ]; then
    echo "== Applying IRQ affinity =="

    if systemctl is-active --quiet irqbalance 2>/dev/null; then
        echo "== Stopping irqbalance service =="
        systemctl stop irqbalance 2>/dev/null || true
    fi

    if systemctl is-enabled --quiet irqbalance 2>/dev/null; then
        echo "== Disabling irqbalance service =="
        systemctl disable irqbalance 2>/dev/null || true
    fi

    if pgrep -x irqbalance >/dev/null 2>&1; then
        echo "== Killing irqbalance process =="
        killall irqbalance >/dev/null 2>&1 || true
        while pgrep -x irqbalance >/dev/null 2>&1; do
            echo "== Waiting for irqbalance to shutdown =="
            sleep 1
        done
    fi

    global_cpu_index=0

    cpu_to_mask() {
    cpu="$1"
    word=$((cpu / 32))
    bit=$((cpu % 32))

    i=0
    mask=""

    while [ "$i" -le "$word" ]; do
        if [ "$i" -eq "$word" ]; then
            val=$(printf "%08x" $((1 << bit)))
        else
            val="00000000"
        fi

        if [ -z "$mask" ]; then
            mask="$val"
        else
            mask="$val,$mask"
        fi

        i=$((i + 1))
    done

    echo "$mask"
}

get_cpus_for_node() {
    node="$1"
    if [ "$node" -lt 0 ]; then
        seq 0 $(( $(nproc) - 1 ))
    else
        cat /sys/devices/system/node/node"$node"/cpulist 2>/dev/null | \
        tr ',' '\n' | awk -F- '
        {
            if (NF == 1) print $1
            else for (i=$1;i<=$2;i++) print i
        }' || seq 0 $(( $(nproc) - 1 ))
    fi
}

balance_iface() {
    iface="$1"

    echo "== Balancing IRQs for interface $iface =="

    sysfs="/sys/class/net/$iface"
    if [ ! -d "$sysfs" ]; then
        echo "== Warning: Interface $iface does not exist =="
        return
    fi

    node=$(cat "$sysfs/device/numa_node" 2>/dev/null || echo -1)
    cpus=$(get_cpus_for_node "$node")
    
    if [ -z "$cpus" ]; then
        cpus=$(seq 0 $(( $(nproc) - 1 )))
    fi

    cpu_array=($cpus)
    cpu_count=${#cpu_array[@]}

    if [ "$cpu_count" -eq 0 ]; then
        echo "==  Warning: No CPUs found =="
        return
    fi

    echo "== Using CPUs: $(echo $cpus | tr '\n' ' ') =="
    echo "== NUMA node: $node =="

    irq_count=0

    device_path=$(readlink -f "$sysfs/device" 2>/dev/null || echo "")
    device_name=""
    
    if [ -n "$device_path" ]; then
        device_name=$(basename "$device_path")
    fi

    irq_list=""

    if [ -f "$sysfs/device/irq" ]; then
        irq=$(cat "$sysfs/device/irq" 2>/dev/null || echo "")
        if [ -n "$irq" ] && [[ "$irq" =~ ^[0-9]+$ ]] && [ -d "/proc/irq/$irq" ] && [ -w "/proc/irq/$irq/smp_affinity" ]; then
            irq_list="${irq_list}${irq_list:+ }$irq"
        fi
    fi

    if [ -f "$sysfs/device/msi_irqs" ]; then
        while IFS= read -r irq; do
            [ -z "$irq" ] && continue
            if [ -d "/proc/irq/$irq" ] && [ -w "/proc/irq/$irq/smp_affinity" ]; then
                if ! echo "$irq_list" | grep -q "\b$irq\b"; then
                    irq_list="${irq_list}${irq_list:+ }$irq"
                fi
            fi
        done < "$sysfs/device/msi_irqs"
    fi

    if [ -d "$sysfs/device/msi_irqs" ]; then
        for msi_irq_file in "$sysfs/device/msi_irqs"/*; do
            if [ -f "$msi_irq_file" ]; then
                irq=$(cat "$msi_irq_file" 2>/dev/null || echo "")
                if [ -n "$irq" ] && [[ "$irq" =~ ^[0-9]+$ ]] && [ -d "/proc/irq/$irq" ] && [ -w "/proc/irq/$irq/smp_affinity" ]; then
                    if ! echo "$irq_list" | grep -q "\b$irq\b"; then
                        irq_list="${irq_list}${irq_list:+ }$irq"
                    fi
                fi
            fi
        done
    fi

    if [ -z "$irq_list" ] && [ -n "$device_path" ]; then
        pci_device_path=""
        if [[ "$device_path" == */pci* ]]; then
            pci_device_path="$device_path"
            while [ -n "$pci_device_path" ] && [ "$pci_device_path" != "/" ]; do
                if [[ "$pci_device_path" == */0000:* ]]; then
                    break
                fi
                pci_device_path=$(dirname "$pci_device_path")
            done
        fi
        
        for irq_dir in /proc/irq/*/; do
            [ ! -d "$irq_dir" ] && continue
            irq=$(basename "$irq_dir")
            if ! [[ "$irq" =~ ^[0-9]+$ ]]; then
                continue
            fi
            
            if [ ! -w "$irq_dir/smp_affinity" ]; then
                continue
            fi
            
            found=false
            
            if [ -n "$device_name" ] && [ -d "$irq_dir$device_name" ]; then
                found=true
            fi
            
            if [ "$found" = false ] && [ -L "$irq_dir../" ]; then
                irq_device=$(readlink -f "$irq_dir../" 2>/dev/null || echo "")
                if [ "$irq_device" = "$device_path" ] || [ "$irq_device" = "$pci_device_path" ]; then
                    found=true
                fi
            fi
            
            if [ "$found" = false ]; then
                for subdir in "$irq_dir"*/; do
                    if [ -L "$subdir" ]; then
                        subdir_target=$(readlink -f "$subdir" 2>/dev/null || echo "")
                        if [ "$subdir_target" = "$device_path" ] || [ "$subdir_target" = "$pci_device_path" ]; then
                            found=true
                            break
                        fi
                    elif [ -d "$subdir" ]; then
                        subdir_name=$(basename "$subdir")
                        if [ "$subdir_name" = "$device_name" ]; then
                            found=true
                            break
                        fi
                    fi
                done
            fi
            
            if [ "$found" = true ]; then
                if ! echo "$irq_list" | grep -q "\b$irq\b"; then
                    irq_list="${irq_list}${irq_list:+ }$irq"
                fi
            fi
        done
    fi

    if [ -z "$irq_list" ] && [ -n "$device_name" ]; then
        for irq_dir in /proc/irq/*/; do
            [ ! -d "$irq_dir" ] && continue
            irq=$(basename "$irq_dir")
            if [[ "$irq" =~ ^[0-9]+$ ]] && [ -d "$irq_dir$device_name" ] && [ -w "$irq_dir/smp_affinity" ]; then
                irq_list="${irq_list}${irq_list:+ }$irq"
            fi
        done
    fi

    if [ -z "$irq_list" ] && [ -n "$device_path" ]; then
        if [ -f "$device_path/irq" ]; then
            irq=$(cat "$device_path/irq" 2>/dev/null || echo "")
            if [ -n "$irq" ] && [[ "$irq" =~ ^[0-9]+$ ]] && [ -d "/proc/irq/$irq" ] && [ -w "/proc/irq/$irq/smp_affinity" ]; then
                if ! echo "$irq_list" | grep -q "\b$irq\b"; then
                    irq_list="${irq_list}${irq_list:+ }$irq"
                fi
            fi
        fi
        
        parent_device=$(dirname "$device_path" 2>/dev/null || echo "")
        if [ -n "$parent_device" ] && [ -f "$parent_device/irq" ]; then
            irq=$(cat "$parent_device/irq" 2>/dev/null || echo "")
            if [ -n "$irq" ] && [[ "$irq" =~ ^[0-9]+$ ]] && [ -d "/proc/irq/$irq" ] && [ -w "/proc/irq/$irq/smp_affinity" ]; then
                if ! echo "$irq_list" | grep -q "\b$irq\b"; then
                    irq_list="${irq_list}${irq_list:+ }$irq"
                fi
            fi
        fi
    fi

    if [ -z "$irq_list" ] && [ -n "$device_name" ]; then
        irq_lines=$(grep -E "(^|[[:space:]])$device_name([[:space:],]|$)" /proc/interrupts 2>/dev/null || true)
        if [ -n "$irq_lines" ]; then
            while IFS= read -r line; do
                [ -z "$line" ] && continue
                irq=$(echo "$line" | awk -F: '{print $1}' | tr -d ' ')
                if [ -n "$irq" ] && [[ "$irq" =~ ^[0-9]+$ ]] && [ -d "/proc/irq/$irq" ] && [ -w "/proc/irq/$irq/smp_affinity" ]; then
                    if [ -d "/proc/irq/$irq/$device_name" ]; then
                        if ! echo "$irq_list" | grep -q "\b$irq\b"; then
                            irq_list="${irq_list}${irq_list:+ }$irq"
                        fi
                    fi
                fi
            done <<< "$irq_lines"
        fi
    fi

    if [ -z "$irq_list" ]; then
        irq_lines=$(grep "$iface" /proc/interrupts 2>/dev/null || true)
        if [ -n "$irq_lines" ]; then
            while IFS= read -r line; do
                [ -z "$line" ] && continue
                irq=$(echo "$line" | awk -F: '{print $1}' | tr -d ' ')
                if [ -n "$irq" ] && [[ "$irq" =~ ^[0-9]+$ ]] && [ -d "/proc/irq/$irq" ] && [ -w "/proc/irq/$irq/smp_affinity" ]; then
                    if ! echo "$irq_list" | grep -q "\b$irq\b"; then
                        irq_list="${irq_list}${irq_list:+ }$irq"
                    fi
                fi
            done <<< "$irq_lines"
        fi
    fi

    if [ -z "$irq_list" ]; then
        echo "== No IRQs found for interface $iface (device: ${device_name:-unknown}) =="
        return
    fi

    for irq in $irq_list; do
        cpu=${cpu_array[$((global_cpu_index % cpu_count))]}
        mask=$(cpu_to_mask "$cpu")
        echo "$mask" > "/proc/irq/$irq/smp_affinity" 2>/dev/null
        if [ $? -eq 0 ]; then
            echo "IRQ $irq => CPU $cpu (mask: $mask)"
            irq_count=$((irq_count + 1))
        fi
        global_cpu_index=$((global_cpu_index + 1))
    done

    if [ "$irq_count" -gt 0 ]; then
        echo "Balanced $irq_count IRQ(s) for interface $iface"
    fi
}

    balance_iface "$LAN_IF"
    balance_iface "$WAN_IF"

fi