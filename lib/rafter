#!/usr/bin/env bash
set -e

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
source "${SCRIPT_DIR}/../purenas.conf"

if [ -n "${RUN_AFTER:-}" ]; then
    echo "== Running post-initialization commands =="
    for cmd in ${RUN_AFTER}; do
        if [[ "${cmd}" =~ ^/ ]]; then
            script_path="${cmd}"
        else
            script_path="${SCRIPT_DIR}/../${cmd}"
        fi
        
        if [ -f "${script_path}" ] && [ -x "${script_path}" ]; then
            echo "== Executing script: ${script_path} =="
            "${script_path}"
        else
            echo "== Executing command: ${cmd} =="
            bash -c "${cmd}"
        fi
    done
fi
